{
  "name": "dsh-file-ref",
  "version": "0.1.0",
  "description": "Codex-style workspace file references for the DeepSeek Harness web GUI: type @ in the composer to browse workspace files and insert the workspace-relative path.",
  "author": "cucen066 <2678082536@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cucen066/dsh-file-ref.git"
  },
  "homepage": "https://github.com/cucen066/dsh-file-ref",
  "bugs": {
    "url": "https://github.com/cucen066/dsh-file-ref/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "web",
    "file-reference",
    "input-trigger"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-input-trigger": "^0.1.0-rc.6"
  },
  "license": "MIT"
}
